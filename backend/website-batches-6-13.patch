@@ -0,0 +1,11 @@
+def authenticated_user_id(sb, request):
+    token = request.headers.get("Authorization", "").removeprefix("Bearer ").strip()
+    if not token:
+        raise PermissionError("authentication_required")
+    user = sb.auth.get_user(token).user
+    if not user or not user.email or not user.email_confirmed_at:
+        raise PermissionError("verified_account_required")
+    users = sb.table("user_login_agent_details").select("id").eq("email", user.email.lower()).limit(2).execute().data or []
+    if len(users) != 1:
+        raise PermissionError("account_mapping_unavailable")
+    return users[0]["id"]
