+def _has_chat_pair(db, homeowner_uid, contractor_uid):
+    """An owned job or an existing server-created enquiry authorizes this pair."""
+    if _has_work_order_pair(db, homeowner_uid, contractor_uid):
+        return True
+    try:
+        result = _stream().channel(
+            "messaging", _channel_id(homeowner_uid, contractor_uid)).query()
+        channel = result.get("channel") or {}
+        members = channel.get("members") or result.get("members") or []
+        ids = {str((m.get("user") or {}).get("id") or m.get("user_id") or "")
+               for m in members if isinstance(m, dict)}
+        return (
+            str(channel.get("homeowner_user_id")) == str(homeowner_uid)
+            and str(channel.get("contractor_user_id")) == str(contractor_uid)
+            and str(channel.get("created_by_id") or
+                    (channel.get("created_by") or {}).get("id")) == str(homeowner_uid)
+            and {str(homeowner_uid), str(contractor_uid)}.issubset(ids)
+        )
+    except Exception:
+        return False
+
+
+def _provision_chat_participants(db, client, *user_ids):
+    # Channel creation fails if either participant has never opened Stream.
+    # Resolve both from the database; no client-provided names or member lists.
+    for user_id in user_ids:
+        rows = (db.table("user_login_agent_details")
+                .select("id,name,given_name,picture_url")
+                .eq("id", int(user_id)).limit(1).execute().data or [])
+        if not rows:
+            raise ValueError("chat_participant_not_found")
+        user = rows[0]
+        payload = {"id": str(user["id"]),
+                   "name": user.get("name") or user.get("given_name") or "User"}
+        if user.get("picture_url"):
+            payload["image"] = user["picture_url"]
+        client.upsert_user(payload)
+
+
 def _channel_id(homeowner_uid, contractor_uid):
