+@bp.post("/arrival-case-response")
+@require_auth("contractor")
+def arrival_case_response():
+    body = request.get_json(silent=True) or {}
+    response_text = str(body.get("response") or "").strip()
+    if not response_text or len(response_text) > 2000:
+        return jsonify(success=False, error="invalid_response"), 400
+    supabase = sb()
+    cases = (supabase.table("arrival_cases").select("*")
+             .eq("id", body.get("caseId")).limit(1).execute()).data or []
+    if not cases:
+        return jsonify(success=False, error="case_not_found"), 404
+    case = cases[0]
+    owned = (supabase.table("work_orders").select("id")
+             .eq("id", case["work_order_id"]).eq("assigned_contractor_user_id", g.legacy_uid)
+             .limit(1).execute()).data or []
+    if not owned:
+        return jsonify(success=False, error="case_not_found"), 404
+    supabase.table("arrival_cases").update({"pro_response": response_text,
+        "responded_at": datetime.now(timezone.utc).isoformat()}).eq("id", case["id"]).execute()
+    return jsonify(success=True)
+
+
+@bp.after_request
+def redact_legacy_access_snapshots(response):
+    # Legacy rows may still carry private snapshots after a job closes. Only
+    # the active-job endpoint below may supply current access notes.
+    if request.endpoint == "contractor.contractor_home_context":
+        return response
+    data = response.get_json(silent=True)
+    if data is None:
+        return response
+    def redact(value):
+        if isinstance(value, dict):
+            for key in ("access_instructions", "access_notes", "accessInstructions"):
+                value.pop(key, None)
+            for item in value.values():
+                redact(item)
+        elif isinstance(value, list):
+            for item in value:
+                redact(item)
+    redact(data)
+    response.set_data(json.dumps(data, default=str))
+    return response
+
+
+@bp.get("/work-orders/<int:work_order_id>/home-context")
+@require_auth("contractor")
+def contractor_home_context(work_order_id):
+    from homeowner.home_profile_routes import _full_profile
+    supabase = sb()
+    jobs = (supabase.table("work_orders").select("*").eq("id", work_order_id)
+            .eq("assigned_contractor_user_id", g.legacy_uid).limit(1).execute()).data or []
+    if not jobs or jobs[0].get("status") not in ("accepted", "en_route", "arrived", "in_progress", "pending_completion"):
+        return jsonify(success=False, error="active_confirmed_job_required"), 403
+    job = jobs[0]
+    if not job.get("home_profile_id"):
+        return jsonify(success=True, home=None, notes=[], systems=[], documents=[])
+    return jsonify(success=True, **_full_profile(supabase, job["requester_user_id"], job["home_profile_id"]))
+
+
+@bp.get("/work-orders/<int:work_order_id>/arrival-cases")
+@require_auth("contractor")
+def contractor_arrival_cases(work_order_id):
+    supabase = sb()
+    owned = (supabase.table("work_orders").select("id").eq("id", work_order_id)
+             .eq("assigned_contractor_user_id", g.legacy_uid).limit(1).execute()).data or []
+    if not owned:
+        return jsonify(success=False, error="work_order_not_found"), 404
+    cases = (supabase.table("arrival_cases")
+             .select("id,work_order_id,reported_at,pro_response,responded_at")
+             .eq("work_order_id", work_order_id).execute()).data or []
+    return jsonify(success=True, cases=cases)
+
